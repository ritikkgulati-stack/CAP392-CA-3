
class Solution {
    public int searchInsert(int[] nums, int target) {

        int l = 0;
        int u = nums.length - 1;
        int mid;

        while (l <= u) {

            mid = (l + u) / 2;

            if (nums[mid] == target) {
                return mid;
            }
            else if (nums[mid] < target) {
                l = mid + 1;
            }
            else {
                u = mid - 1;
            }
        }

        return l;
    }
}
